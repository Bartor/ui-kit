{
  "name": "@bartor-net/ui-kit",
  "version": "0.3.1",
  "description": "React components for maps of city data: sidebar and controls, detail panels, hourly charts, modal-split pies, Leaflet layers",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bartor/ui-kit.git"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./map": {
      "types": "./dist/map.d.ts",
      "default": "./dist/map.js"
    },
    "./charts": {
      "types": "./dist/charts.d.ts",
      "default": "./dist/charts.js"
    },
    "./pl": {
      "types": "./dist/strings/pl.d.ts",
      "default": "./dist/strings/pl.js"
    },
    "./styles.css": "./dist/styles.css",
    "./base.css": "./dist/base.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite --config vite.demo.config.js",
    "typecheck": "tsc",
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "prepack": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "leaflet": "^1.9.4",
    "react": ">=18",
    "react-dom": ">=18",
    "react-leaflet": ">=4.2",
    "recharts": "^2.15.0"
  },
  "peerDependenciesMeta": {
    "leaflet": {
      "optional": true
    },
    "react-leaflet": {
      "optional": true
    },
    "recharts": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "recharts": "^2.15.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.7",
    "vitest": "^3.2.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
