{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [],
    "paths": {
      "@bartor-net/ui-kit": ["./src/index.ts"],
      "@bartor-net/ui-kit/map": ["./src/map.ts"],
      "@bartor-net/ui-kit/charts": ["./src/charts.ts"],
      "@bartor-net/ui-kit/pl": ["./src/strings/pl.ts"]
    }
  },
  "include": ["src", "demo"]
}
